{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "enterprise_type",
    "statement_template",
    "account_groups",
    "items"
  ],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "enterprise_type": {
      "enum": ["general", "bank", "securities", "insurance", "other_financial"]
    },
    "statement_template": {"type": "array"},
    "account_groups": {"type": "object"},
    "statement_mapping": {"type": "array"},
    "control_destinations": {"type": "array"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "name",
          "section",
          "display_order",
          "verification_record_id",
          "components"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "section": {"enum": ["operating", "investing", "financing", "cash"]},
          "display_order": {"type": "integer"},
          "verification_record_id": {"type": "string", "minLength": 1},
          "is_subtotal": {"type": "boolean"},
          "subtotal_of": {"type": "array", "items": {"type": "string"}},
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "component_id",
                "operation",
                "sign",
                "source_scope",
                "selector",
                "occupancy_policy"
              ],
              "properties": {
                "component_id": {"type": "string", "minLength": 1},
                "operation": {"type": "string", "minLength": 1},
                "sign": {"enum": [-1, 1]},
                "source_scope": {"type": "string", "minLength": 1},
                "selector": {"type": "object"},
                "occupancy_policy": {"enum": ["exclusive", "shared_control"]},
                "gross_or_net": {
                  "enum": ["gross", "net", "not_applicable"]
                },
                "noncash_exclusions": {"type": "array"},
                "special_adjustments": {"type": "array"},
                "restricted_cash_treatment": {"type": "array"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
